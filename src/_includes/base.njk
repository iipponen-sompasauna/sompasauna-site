<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {%- if title and page.url != "/" %}{{ title }} – {% endif -%}{{ site.name }}
    </title>
    <meta name="description" content="{{ description or site.description }}" />
    {% if site.noindex %}<meta name="robots" content="noindex" />{% endif %}
    <meta property="og:title" content="{% if title and page.url != '/' %}{{ title }} – {% endif %}{{ site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/style.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Siirry sisältöön</a>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/assets/img/sompaleijona.svg" alt="" width="44" height="44" />
        <span>Sompasauna</span>
      </a>
      <nav aria-label="Päävalikko">
        <ul>
          {% for item in site.nav %}
          <li>
            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a>
          </li>
          {% endfor %}
        </ul>
      </nav>
    </header>

    <main id="main" class="content">
      {% if title and page.url != "/" %}<h1>{{ title }}</h1>{% endif %}
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>{{ site.address }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p>Sompasaunaseura ry · Y-tunnus {{ site.businessId }} · Rahankeräyslupa {{ site.fundraisingPermit }}</p>
      <p><a href="/tietosuoja/">Tietosuojaseloste</a></p>
    </footer>
  </body>
</html>
